{
  "version": 2,
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://gita-backend.railway.app/api/$1" },
    { "source": "/trpc/(.*)", "destination": "https://gita-backend.railway.app/api/trpc/$1" },
    { "source": "/uploads/(.*)", "destination": "https://gita-backend.railway.app/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
