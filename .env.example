# Server Configuration
PORT=                          # Port number for the server (default 4001)

# Database
DATABASE_URL=                  # MySQL connection string

# Authentication  
JWT_SECRET=                    # Secret key for JWT token signing (use a long random string)
ADMIN_USERNAME=                # Default admin account username
ADMIN_PASSWORD=                # Default admin account password

# Google OAuth
GOOGLE_CLIENT_ID=              # From Google Cloud Console
GOOGLE_CLIENT_SECRET=          # From Google Cloud Console
VITE_GOOGLE_CLIENT_ID=         # Same as GOOGLE_CLIENT_ID (for frontend)

# AI Service
GEMINI_API_KEY=                # From Google AI Studio

# File Storage (Backblaze B2)
B2_ENDPOINT=                   # Backblaze B2 endpoint URL
B2_REGION=                     # Backblaze B2 region
B2_BUCKET_NAME=                # Name of your B2 bucket
B2_APPLICATION_KEY_ID=         # Backblaze application key ID
B2_APPLICATION_KEY=            # Backblaze application key

# OAuth Server (if using separate auth server)
OAUTH_SERVER_URL=              # URL of OAuth server
VITE_OAUTH_SERVER_URL=         # Same URL for frontend use
BUILT_IN_FORGE_API_URL=        # Built-in forge API URL
BUILT_IN_FORGE_API_KEY=        # Built-in forge API key
VITE_API_URL=                  # Backend API URL for frontend
